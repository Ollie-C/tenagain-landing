---
import Hero from './Hero.astro';
import { APP_URL } from '../config';
---
<div class="landing-views" data-landing-views data-app-url={APP_URL}>
  <nav class="view-navigation" aria-label="Landing views" data-view-navigation hidden>
    <button type="button" class="view-entry" data-view-entry aria-controls="view-monthly">Elimination</button>
    <button type="button" class="view-arrow view-arrow--prev" data-view-prev aria-label="Previous landing view" aria-controls="view-monthly"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 4-8 8 8 8" /></svg></button>
    <button type="button" class="view-arrow view-arrow--next" data-view-next aria-label="Next landing view" aria-controls="view-monthly"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 4 8 8-8 8" /></svg></button>
  </nav>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-view-announcement>Score</p>
  <section id="view-score" role="region" aria-label="Score" tabindex="-1" data-view-panel="score">
    <Hero />
    <section class="welcome" aria-labelledby="welcome-title">
      <div><h2 id="welcome-title">Welcome to <strong>tenagain.</strong></h2><p class="competition-link" data-competition-fallback hidden>Can't load the Elimination competition. Try refreshing the page.</p></div>
      <p class="welcome-cycle"><span>Watch,</span><span>Rate,</span><span>Rank,</span><span>Watch.</span></p>
    </section>
  </section>
  <section id="view-monthly" role="region" aria-label="Elimination competition" tabindex="-1" data-view-panel="monthly" hidden>
    <div class="monthly-stage landing-content-width"><iframe title="tenagain Elimination competition" data-weekly-frame allow="clipboard-write" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
  </section>
  <div class="view-bricks" data-view-bricks aria-hidden="true"></div>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-landing-views]');
  if (root) {
    let names = ['score'];
    const arrows = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-view-prev], [data-view-next]'));
    const navigation = root.querySelector<HTMLElement>('[data-view-navigation]');
    const entry = root.querySelector<HTMLButtonElement>('[data-view-entry]');
    const fallback = root.querySelector<HTMLElement>('[data-competition-fallback]');
    const announcement = root.querySelector<HTMLElement>('[data-view-announcement]');
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-view-panel]'));
    const frame = root.querySelector<HTMLIFrameElement>('[data-weekly-frame]');
    const appOrigin = new URL(root.dataset.appUrl || 'https://app.tenagain.app').origin;
    const bricks = root.querySelector<HTMLElement>('[data-view-bricks]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let transitionId = 0;
    let animations: Animation[] = [];
    let active = 'score';
    let availabilityKnown = false;
    let liveLabel = 'Elimination';
    let pendingMonthly = ['monthly', 'weekly'].includes(new URL(window.location.href).searchParams.get('view') || '');
    const requested = new URL(window.location.href).searchParams.get('competition') || 'current';
    const slug = requested.length <= 100 && /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(requested) ? requested : 'current';
    function ensureFrame() {
      if (frame && !frame.getAttribute('src')) frame.src = `${appOrigin}/embed/competitions/${encodeURIComponent(slug)}`;
    }
    function reveal(panel: HTMLElement, direction: number) {
      animations.forEach(animation => animation.cancel());
      animations = [];
      if (!bricks || reducedMotion.matches) { bricks?.replaceChildren(); return; }
      const columns = window.innerWidth < 760 ? 4 : 8;
      const rows = 8;
      bricks.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
      bricks.replaceChildren();
      const id = ++transitionId;
      for (let row = 0; row < rows; row++) {
        for (let col = 0; col < columns; col++) {
          const brick = document.createElement('span');
          brick.style.background = '#101010';
          bricks.append(brick);
          const wave = direction > 0 ? col : columns - 1 - col;
          const delay = wave * 26 + row * 18 + (row % 2) * 20;
          const animation = brick.animate([{opacity: 1}, {opacity: 0}], {
            duration: 400, delay, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'both'
          });
          animations.push(animation);
        }
      }
      animations.push(panel.animate([{opacity: .4}, {opacity: 1}], {duration: 480, easing: 'ease-out'}));
      void Promise.all(animations.map(animation => animation.finished.catch(() => {}))).then(() => {
        if (id === transitionId) { bricks.replaceChildren(); animations = []; }
      });
    }

    function select(name: string, history = true, focus = false) {
      const previous = active;
      if (name === 'weekly') name = 'monthly';
      active = names.includes(name) ? name : 'score';
      if (active === 'monthly') ensureFrame();
      panels.forEach(panel => { panel.hidden = panel.dataset.viewPanel !== active; });
      const panel = panels.find(panel => panel.dataset.viewPanel === active);
      if (panel && previous !== active) reveal(panel, active === 'monthly' ? 1 : -1);
      if (announcement) announcement.textContent = `${active === 'monthly' ? 'Elimination competition' : 'Score'}${names.length > 1 ? ` · view ${names.indexOf(active) + 1} of 2` : ''}`;
      arrows.forEach(arrow => arrow.setAttribute('aria-controls', `view-${active === 'score' ? 'monthly' : 'score'}`));
      if (entry) { entry.textContent = active === 'score' ? liveLabel : 'Score'; entry.setAttribute('aria-controls', `view-${active === 'score' ? 'monthly' : 'score'}`); entry.setAttribute('aria-pressed', String(active === 'monthly')); }
      if (focus) panel?.focus({preventScroll: true});
      document.body.dataset.landingView = active;
      if (history) {
        const url = new URL(window.location.href);
        if (active === 'score') url.searchParams.delete('view'); else url.searchParams.set('view',active);
        window.history.pushState({},'',url);
        window.scrollTo({top:0,behavior:'instant'});
      }
      document.dispatchEvent(new CustomEvent('tenagain:landing-view', {detail: active}));
    }
    function removeUnavailableView() {
      const url = new URL(window.location.href);
      if (url.searchParams.has('view')) { url.searchParams.delete('view'); window.history.replaceState({},'',url); }
    }
    function setAvailability(isActive: boolean) {
      names = isActive ? ['score', 'monthly'] : ['score'];
      if (navigation) navigation.hidden = !isActive;
      if (!availabilityKnown) {
        availabilityKnown = true;
        if (pendingMonthly && isActive) select('monthly', false);
        else if (!isActive) removeUnavailableView();
        pendingMonthly = false;
      } else if (!isActive && active === 'monthly') {
        select('score', false, true); removeUnavailableView();
      }
    }
    async function loadAvailability() {
      if (frame?.getAttribute('src')) return; // Once opened, the widget reports its own state.
      try {
        const url = new URL('/api/competitions/availability', appOrigin);
        url.searchParams.set('competition', slug);
        const response = await fetch(url, { credentials: 'omit', signal: AbortSignal.timeout(6000) });
        if (!response.ok) throw new Error('Availability unavailable');
        const state = await response.json();
        if (typeof state.active !== 'boolean') throw new Error('Invalid availability');
        liveLabel = 'Elimination';
        if (entry && active === 'score') entry.textContent = liveLabel;
        if (fallback) fallback.hidden = true;
        setAvailability(state.active);
      } catch {
        if (fallback && pendingMonthly) fallback.hidden = false;
        setAvailability(false);
      }
    }
    entry?.addEventListener('click', () => select(active === 'score' ? 'monthly' : 'score'));
    arrows.forEach(arrow => {
      arrow.addEventListener('keydown', event => {
        if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key) || names.length < 2) return;
        event.preventDefault();
        select(event.key === 'Home' ? 'score' : event.key === 'End' ? 'monthly' : active === 'score' ? 'monthly' : 'score');
      });
      arrow.addEventListener('click', () => select(active === 'score' ? 'monthly' : 'score'));
    });
    window.addEventListener('popstate', () => {
      const requested = new URL(window.location.href).searchParams.get('view') || 'score';
      select(requested,false);
      if (availabilityKnown && !names.includes(requested === 'weekly' ? 'monthly' : requested)) removeUnavailableView();
    });
    window.addEventListener('message', event => {
      if (event.origin !== appOrigin || event.source !== frame?.contentWindow || !event.data) return;
      if (event.data.type === 'tenagain:competition-state' && typeof event.data.active === 'boolean') {
        setAvailability(event.data.active);
      } else if (event.data.type === 'tenagain:competition-resize') {
        const height = Number(event.data.height);
        if (frame && Number.isFinite(height) && height >= 100 && height <= 10000) frame.style.height = `${Math.ceil(height)}px`;
      }
    });
    select('score',false);
    void loadAvailability();
    const availabilityPoll = window.setInterval(() => { if (!document.hidden) void loadAvailability(); }, 60000);
    window.addEventListener('pagehide', () => window.clearInterval(availabilityPoll), { once: true });
    if (new URL(window.location.href).searchParams.get('view') === 'product') removeUnavailableView();
  }
</script>
<style>
[hidden]{display:none!important}
.view-bricks{position:fixed;inset:0;z-index:25;display:grid;grid-template-rows:repeat(8,1fr);pointer-events:none}
.view-navigation{position:fixed;top:0;height:6rem;left:50%;transform:translateX(-50%);width:max-content;max-width:calc(100% - 12rem);z-index:60;display:flex;align-items:stretch;gap:4px;padding:0;border:0;background:linear-gradient(90deg,#050505b8,#050505cc 8%,#050505cc 92%,#050505b8);color:#fff;backdrop-filter:blur(10px)}
.view-entry{height:100%;display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:4px 8px;border:0;border-radius:0;background:transparent;color:#fff;font-family:var(--font-sans);font-size:1rem;font-weight:650;line-height:1.1;letter-spacing:.13em;text-transform:uppercase;white-space:nowrap;box-shadow:none;cursor:pointer;transition:transform 220ms var(--ease-soft)}
.view-entry:hover,.view-entry[aria-pressed=true]{color:#fff;background:transparent;font-weight:850;transform:scale(1.04);box-shadow:none}
.view-entry:focus-visible{outline:2px solid #fff;outline-offset:4px}
@media(max-width:639px){.view-entry{min-height:36px;padding:.5rem;border:1px solid #fff;border-top:0;border-radius:var(--radius-sm);font-size:.75rem;letter-spacing:.1em}.view-entry[aria-pressed=true]{background:#fff;color:#050505;box-shadow:2px 2px 0 #fff;transform:none}}
.competition-link{font-size:13px;line-height:1.5;color:#bbb;margin:12px 0 16px}
.view-arrow{display:none;align-items:center;justify-content:center;width:28px;height:32px;padding:6px;border:0;box-shadow:none;background:transparent;color:#ccc;cursor:pointer;border-radius:0}
.view-arrow--prev{order:0}.view-arrow--next{order:2}
.view-arrow svg{width:14px;height:18px}
.view-arrow:hover,.view-arrow:active{color:#fff;background:#ffffff12;box-shadow:none;transform:none}
.view-arrow:focus-visible{outline:2px solid #fff;outline-offset:0}
.monthly-stage{padding-block:7.75rem 3rem;min-height:100svh}
.monthly-stage iframe{display:block;width:100%;height:850px;min-height:0;border:0;color-scheme:dark}
.welcome{max-width:1180px;margin:auto;padding:72px 48px 32px;display:grid;grid-template-columns:1fr 1fr;gap:24px;color:#eee;border-top:1px solid #333}
.welcome h2{font-size:clamp(20px,2.5vw,30px);font-weight:400;line-height:1.4;margin:4px 0 0;color:#aaa}
.welcome h2 strong{color:#fff;font-weight:600}
.welcome-cycle{font-family:var(--font-display);font-size:clamp(42px,6vw,70px);line-height:1.05;margin:0;font-weight:600;letter-spacing:.025em}
.welcome-cycle span{display:block}.welcome-cycle span:last-child{color:#777}

:global(body){background:#0a0a0a}
:global(body[data-landing-view=monthly]::before),:global(body[data-landing-view=monthly]::after),:global(body[data-landing-view=monthly] .landing-nav::after){display:none}
@media(max-width:639px){.view-navigation{top:0;height:4.75rem;left:calc(50% + .75rem)}.monthly-stage{padding-block:7.5rem 2rem}}
@media(max-width:760px){.welcome{padding:44px 32px 28px;grid-template-columns:1fr;gap:24px}.welcome-cycle{font-size:52px}}
</style>
