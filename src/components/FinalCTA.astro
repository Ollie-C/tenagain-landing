---
import { links } from '../config';
---

<section class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div
      class="reveal border-2 border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-10 text-center sm:p-16"
      style="box-shadow: 4px 4px 0 0 var(--color-border)"
    >
      <h2 class="text-3xl font-bold tracking-tight text-[var(--color-text)] sm:text-4xl">
        Start ranking your movies
      </h2>
      <p class="mx-auto mt-4 max-w-md text-[var(--color-text-muted)]">
        Try it on this device first, then create an account whenever you want to keep it.
      </p>
      <div class="mt-10">
        <a
          href={links.guest}
          class="neo-btn inline-flex items-center justify-center border-2 border-[var(--color-accent)] bg-[var(--color-accent)] px-10 py-4 text-sm font-semibold uppercase tracking-widest text-[var(--color-accent-foreground)]"
          style="box-shadow: 3px 3px 0 0 var(--color-border)"
        >
          Try MyVu as a guest
        </a>
      </div>
    </div>
  </div>
</section>
