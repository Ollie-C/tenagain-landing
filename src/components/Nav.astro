---
import { APP_URL } from '../config';

const initialRedirect = encodeURIComponent('/discover?mediaType=movie');
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<header class="landing-nav">
  <nav class="landing-nav__inner" aria-label="Main navigation">
    <a href="/" class="landing-nav__brand" aria-label="MyVu home">MV</a>

    <div class="media-switcher" role="radiogroup" aria-label="Media type">
      <button type="button" role="radio" aria-label="Movies" aria-checked="true" class="media-switcher__option is-active" data-mode-option="movie">
        M
      </button>
      <button type="button" role="radio" aria-label="TV" aria-checked="false" class="media-switcher__option" data-mode-option="tv_show">
        T
      </button>
    </div>

    <div class="landing-nav__actions">
      <a href={`${APP_URL}/login?redirect=${initialRedirect}`} class="landing-nav__signin" data-app-signin>Sign in</a>
    </div>
  </nav>
</header>
