---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.png' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" id="meta-theme-color" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="MyVu" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="MyVu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-rajdhani" preload />

    <!-- Restore saved theme before paint to prevent flash -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('myvu-theme');
        var colors = { dark: '#0a0a0a', light: '#f5f5f5', polaroid: '#d8c09b' };
        if (t === 'light' || t === 'dark' || t === 'polaroid') {
          document.documentElement.setAttribute('data-theme', t);
          var m = document.getElementById('meta-theme-color');
          if (m) m.setAttribute('content', colors[t]);
        }
      })();
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var current = document.documentElement.getAttribute('data-theme') || 'dark';
        var next = current === 'dark' ? 'light' : current === 'light' ? 'polaroid' : 'dark';
        btn.setAttribute(
          'aria-label',
          'Switch to ' + next + ' theme'
        );
        btn.setAttribute('aria-pressed', current === 'dark' ? 'false' : 'true');
      });
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "MyVu",
      "url": "https://myvu.app",
      "applicationCategory": "EntertainmentApplication",
      "operatingSystem": "Web",
      "description": description,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />

    <script is:inline>
      /* Theme toggle */
      document.getElementById('theme-toggle').addEventListener('click', function() {
        var html = document.documentElement;
        var btn = this;
        var current = html.getAttribute('data-theme') || 'dark';
        var next = current === 'dark' ? 'light' : current === 'light' ? 'polaroid' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('myvu-theme', next);
        document.getElementById('meta-theme-color').setAttribute('content', {
          dark: '#0a0a0a', light: '#f5f5f5', polaroid: '#d8c09b'
        }[next]);
        btn.setAttribute('aria-label', 'Switch to ' + (next === 'dark' ? 'light' : next === 'light' ? 'polaroid' : 'dark') + ' theme');
        btn.setAttribute('aria-pressed', next === 'dark' ? 'false' : 'true');
      });

      /* Scroll-reveal via IntersectionObserver */
      (function() {
        var els = document.querySelectorAll('.reveal');
        if (!els.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          els.forEach(function(el) { el.classList.add('in-view'); });
          return;
        }

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

        els.forEach(function(el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
